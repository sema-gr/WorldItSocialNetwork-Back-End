{
	"name": "chitchatbackend",
	"main": "index.js",
	"scripts": {
		"start": "bun dist/index.js",
		"dev": "bun run src/index.ts",
		"build": "tsc",
		"prisma:generate": "prisma generate",
		"test": "echo \"No tests specified\" && exit 0",
		"prisma:format": "prisma/schema format",
		"prisma:migrate": "prisma migrate dev",
		"prisma:seed": "bun prisma/seed.ts",
		"prepare": "husky install",
		"lint": "bunx eslint . --ext .ts",
		"lint:fix": "bunx eslint . --ext .ts --fix",
		"format": "bunx prettier --write .",
		"prettier:check": "bunx prettier --check .",
		"copy:prisma": "powershell -Command \"New-Item -ItemType Directory -Force dist/generated | Out-Null; Copy-Item -Recurse -Force src/generated/* dist/generated\"",
		"release": "semantic-release"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@prisma/client": "^6.7.0",
		"@types/jsonwebtoken": "^9.0.9",
		"bcryptjs": "^3.0.2",
		"cors": "^2.8.5",
		"dotenv": "^16.5.0",
		"express": "^5.1.0",
		"husky": "^9.1.7",
		"jsonwebtoken": "^9.0.2",
		"nodemailer": "^6.10.1",
		"prisma": "^6.7.0",
		"socket.io": "^4.8.1",
		"uuid": "^11.1.0"
	},
	"devDependencies": {
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^11.0.6",
		"@semantic-release/npm": "^12.0.2",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.1",
		"@types/nodemailer": "^6.4.17",
		"@typescript-eslint/eslint-plugin": "^8.48.0",
		"@typescript-eslint/parser": "^8.48.0",
		"eslint": "^8.57.1",
		"eslint-config-airbnb-base": "^15.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"prettier": "^3.7.3",
		"semantic-release": "^24.2.9",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3"
	},
	"prisma": {
		"schema": "./prisma"
